<suite name="Grid Suite" parallel="tests" thread-count="3">

    <parameter name="node" value="http://localhost:4444/wd/hub"/>

    <test name="Chrome Test">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="gridTests.SeleniumGridDemo"/>
        </classes>
    </test>

    <test name="Firefox Test">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="gridTests.SeleniumGridDemo"/>
        </classes>
    </test>

    <test name="Edge Test">
        <parameter name="browser" value="MicrosoftEdge"/>
        <classes>
            <class name="gridTests.SeleniumGridDemo"/>
        </classes>
    </test>

</suite>
