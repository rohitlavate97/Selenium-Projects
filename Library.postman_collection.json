		{
			"name": "DeleteBook",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const schema = {\r",
							"  \"type\": \"object\",\r",
							"  \"properties\": {\r",
							"    \"msg\": {\r",
							"      \"type\": \"string\"\r",
							"    }\r",
							"  },\r",
							"  \"required\": [\r",
							"    \"msg\"\r",
							"  ]\r",
							"};\r",
							"pm.test(\"Validate the message after succesful operation\",function()\r",
							"{\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.msg).to.eql(\"book is successfully deleted\");\r",
							"    if(pm.collectionVariables.get(\"flag\"))\r",
							"    {\r",
							"        postman.setNextRequest(\"AddBook\");\r",
							"        pm.collectionVariables.set(\"flag\",false);\r",
							"    }\r",
							"});\r",
							"pm.test(\"validating the schema for DeleteBook API\",function()\r",
							"{\r",
							"    pm.response.to.have.jsonSchema(schema);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
