	"item": [
		{
			"name": "AddBook",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const code = pm.globals.get(\"CompanyCode\");\r",
							"const val = pm.variables.replaceIn('{{$randomInt}}');\r",
							"\r",
							"pm.collectionVariables.set(\"isbn\", code + val);\r",
							"//pm.collectionVariables.set(\"author_name\", \"Rohit Prime\");\r",
							"pm.collectionVariables.set(\"book_name\",pm.iterationData.get(\"BookName\"));\r",
							"pm.collectionVariables.set(\"author_name\",pm.iterationData.get(\"Author\"));\r",
							"console.log(pm.collectionVariables.get(\"author_name\"));\r",
							"\r",
							"const jsonData = pm.response.json();\r",
							"const bookId = jsonData.ID;\r",
							"pm.environment.set(\"book_id\", bookId);\r",
							"function generateBookId()\r",
							"{\r",
							"    var req = JSON.parse(pm.request.body.raw);\r",
							"    const expected_id = req.isbn + req.aisle;\r",
							"    return expected_id;\r",
							"}\r",
							"function cleanupScript()\r",
							"{\r",
							"    const book_id = generateBookId();\r",
							"    pm.environment.set(\"book_id\",book_id);\r",
							"    console.log(\"calling DeleteBook\");\r",
							"    pm.collectionVariables.set(\"flag\",true);\r",
							"    postman.setNextRequest(\"DeleteBook\");\r",
							"    //pm.execution.setNextRequest(\"DeleteBook\");\r",
							"}\r",
							"pm.test(\"validate status code is 200\", function () {\r",
							"    try\r",
							"    {\r",
							"        pm.response.to.have.status(200);\r",
							"        pm.expect(jsonData).to.have.property(\"Msg\");\r",
							"        pm.expect(jsonData.Msg).to.eql(\"successfully added\");\r",
							"    }\r",
							"    catch(err)\r",
							"    {\r",
							"        //check if error is due to already book exists\r",
							"        if(jsonData.Msg.includes(\"Exists\"))\r",
							"        {\r",
							"            cleanupScript();\r",
							"        }\r",
							"    }\r",
							"});\r",
							"\r",
							"pm.test(\"Header cookies response time validations\", function () {\r",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"application/json;charset=UTF-8\");\r",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
							"    //pm.expect(pm.response.text()).to.include(\"successfully added\");\r",
							"});\r",
							"\r",
							"pm.test(\"ID Logic validation\", function () {\r",
							"    //const isbn_val = pm.collectionVariables.get(\"isbn\");\r",
							"    // const req = JSON.parse(pm.request.body.raw);\r",
							"\r",
							"    // pm.expect(req).to.have.property(\"isbn\");\r",
							"    // pm.expect(req).to.have.property(\"aisle\");\r",
							"\r",
							"    const expected_id = generateBookId();\r",
							"    pm.expect(expected_id).to.eql(bookId);\r",
							"});\r",
							"\r",
							"// pm.test(\"Delay test by 2 seconds\", function (done) {\r",
							"//     setTimeout(function () {\r",
							"//         pm.expect(pm.response.code).to.eql(200);\r",
							"//         done();\r",
							"//     }, 1000); // 2000 ms = 2 seconds\r",
							"// });\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"method": "GET",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\":\"{{book_name}}\",\r\n    \"isbn\":\"{{isbn}}\",\r\n    \"aisle\":\"8772\",\r\n    \"author\":\"{{author_name}}\"\r\n}\r\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/Library/Addbook.php",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"Library",
						"Addbook.php"
					]
				}
			},
			"response": []
		},
		{
			"name": "GetBook",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const getBookResponse = pm.response.json();\r",
							"console.log(getBookResponse);\r",
							"const schema = {\r",
							"  \"type\": \"array\",\r",
							"  \"items\": [\r",
							"    {\r",
							"      \"type\": \"object\",\r",
							"      \"properties\": {\r",
							"        \"book_name\": {\r",
							"          \"type\": \"string\"\r",
							"        },\r",
							"        \"isbn\": {\r",
							"          \"type\": \"string\"\r",
							"        },\r",
							"        \"aisle\": {\r",
							"          \"type\": \"string\"\r",
							"        },\r",
							"        \"author\": {\r",
							"          \"type\": \"string\"\r",
							"        }\r",
							"      },\r",
							"      \"required\": [\r",
							"        \"book_name\",\r",
							"        \"isbn\",\r",
							"        \"aisle\",\r",
							"        \"author\"\r",
							"      ]\r",
							"    }\r",
							"  ]\r",
							"};\r",
							"pm.test(\"Validate JSON response logic\",function()\r",
							"{\r",
							"    pm.expect(getBookResponse[0].author).to.eql(pm.collectionVariables.get(\"author_name\"));\r",
							"});\r",
							"\r",
							"// pm.test(\"Validate JSON response logic\", function () {\r",
							"//     const jsonData = pm.response.json();\r",
							"\r",
							"//     pm.expect(jsonData).to.be.an(\"array\");\r",
							"//     pm.expect(jsonData[0]).to.have.property(\"author\");\r",
							"//     pm.expect(jsonData[0].author).to.eql(\"Natraj Chowdhary\");\r",
							"// });\r",
							"\r",
							"\r",
							"pm.test(\"Validate the JSON response schema\",function(){\r",
							"    pm.response.to.have.jsonSchema(schema);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
